{
	"name": "@torounit/inline-typography-controls",
	"version": "0.5.2",
	"license": "GPL-3.0-or-later",
	"author": "Toro_Unit",
	"scripts": {
		"wp-env": "wp-env",
		"dev": "wp-scripts start",
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint-css": "wp-scripts lint-style",
		"lint-css:fix": "wp-scripts lint-style --fix",
		"lint-js": "wp-scripts lint-js",
		"lint-js:fix": "wp-scripts lint-js --fix",
		"type-check": "tsc --noEmit",
		"lint-php": "composer lint",
		"lint-php:fix": "composer format",
		"packages-update": "wp-scripts packages-update",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,json,ts,tsx}": [
			"npm run format"
		],
		"*.{js,ts,tsx}": [
			"npm run lint-js:fix"
		],
		"*.{ts,tsx}": [
			"bash -c 'npm run type-check'"
		],
		"{*.css,*.scss}": [
			"npm run lint-css:fix"
		],
		"*.php": [
			"composer format",
			"npm run lint-php"
		]
	},
	"dependencies": {
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/primitives": "^5.0.0",
		"@wordpress/rich-text": "^8.0.0"
	},
	"devDependencies": {
		"@types/wordpress__block-editor": "^15.0.8",
		"@wordpress/env": "^12.0.0",
		"@wordpress/prettier-config": "^5.0.0",
		"@wordpress/scripts": "^37.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"npm-run-all": "^4.1.5",
		"prettier": "npm:wp-prettier@^3.9.6"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	}
}
